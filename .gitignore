# Byte-compiled / cache
__pycache__/
*.pyc

# Historical K-line cache (regenerable from moomoo OpenD, ~38MB)
data_cache/

# Ad-hoc analysis run logs (can reach 10MB+ per run, not source)
*.log
logs_europe_us.out

# Simulated/live portfolio state (runtime data, regenerates on each run)
portfolio/positions.json

# Single-instance lock for main.py (runtime data, holds current PID)
.kabu_loop.lock

# watchdog.py heartbeat timestamp (runtime data, rewritten every run_loop
# iteration — see engine/runner.py)
.kabu_heartbeat

# Broker order audit trail (runtime data, accumulates over time; see
# engine/broker.py)
trade_audit.jsonl

# v2.6 Trade Intelligence Database (runtime data — accumulates real trade
# history, not source; see engine/trade_tracker.py)
engine/trade_history.db
engine/trade_history.db-wal
engine/trade_history.db-shm

# V2.7 Stage 3 HMM regime models — regenerable from data_cache/ via
# `python -m engine.hmm_regime --codes ...` (engine/hmm_regime.py), not source
engine/hmm_models/

# V2.7 Stage 3 Shadow Mode runtime state/log — accumulates over time, not
# source (see engine/regime_store.py, engine/hmm_shadow.py)
engine/regime_state.json
engine/regime_shadow_log.csv

# Editor/OS
.vscode/
.idea/
Thumbs.db
